#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <behaviors/num_word.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
backs: back_del {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp BKSP>, <&kp DEL>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

esctb: esc_tab {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp TAB>, <&kp ESC>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

uppies: shift_caps {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp LSHFT>, <&kp CAPS>;
    mods = <(MOD_LCTL)>;
};

coppy: tap_dance_copy_paste {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&kp LC(C)>, <&kp LC(V)>;
};

qur: tap_dance_q_undo_redo {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&kp Q>, <&kp LC(Z)>, <&kp LC(Y)>;
};

equlpls: equal_plus {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp EQUAL>, <&kp PLUS>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

prcntastk: percent_asterisk {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp PRCNT>, <&kp ASTRK>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

one: 1_F1 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N1>, <&kp F1>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

two: 2_F2 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N2>, <&kp F2>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

three: 3_F3 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N3>, <&kp F3>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

four: 4_F4 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N4>, <&kp F4>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

five: 5_F5 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N5>, <&kp F5>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

six: 6_F6 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N6>, <&kp F6>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

seven: 7_F7 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N7>, <&kp F7>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

eight: 8_F8 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N8>, <&kp F8>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

nine: 9_F9 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp KP_N9>, <&kp F9>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

zero: 0_F10 {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&mt COMMA KP_N0>, <&kp F10>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

vols: mod_morph_volup_voldwn_mute {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>, <&kp C_MUTE>;
    mods = <(MOD_LSFT|MOD_RSFT)>, <(MOD_LCTL|MOD_RCTL)>;
};

btmorph: mod_morph_bt1_bt2_btclr {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&bt BT_SEL 1>, <&bt BT_SEL 2>, <&bt BT_CLR_ALL>;
    mods = <(MOD_LSFT|MOD_RSFT)>, <(MOD_LCTL|MOD_RCTL)>;
};

bri: brightup_brightdwn {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&kp C_BRI_DN>, <&kp C_BRI_UP>;
    mods = <(MOD_LSFT|MOD_RSFT)>;
};

num_word: num_word {
    #binding-cells = <0>;
    compatible = "zmk,behavior-num-word";
    continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL LPAR RPAR>;
    ignore-numbers;
};

nummies: new_num_word {
    #binding-cells = <0>;
    compatible = "zmk,behavior-num-word";
    layers = <(1)>;
    continue-list = <BSPC EQUAL>;
    ignore-numbers;
};
};

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // | N/A | LWR | ⌫ |  P  |  Y  |  F  |      |  G  |  C  |  R  |  L  | RSE | N/A |
            // | N/A |  A  |  O  |  E  |  U  |  I  |      |  D  |  H  |  T  |  N  |  S  | N/A |
            // | N/A |coppy|  Q  |  J  |  K  |  X  |      |  B  |  M  |  W  |  V  |  Z  | N/A |
            //                    | CTRL | .(') | __ |  |  ⬆  | ,(") |  ↵  |

            bindings = <
&none   &tog 2  &backs  &kp P   &kp Y   &kp F           &kp G   &kp C   &kp R   &kp L   &tog 1  &none
&none   &kp A   &kp O   &kp E   &kp U   &kp I           &kp D   &kp H   &kp T   &kp N   &kp S   &none
&none   &coppy  &qur    &kp J   &kp K   &kp X           &kp B   &kp M   &kp W   &kp V   &kp Z   &none
      &kp LCTRL  &mt SINGLE_QUOTE DOT  &kp SPACE      &kp LSHIFT  &mt AT COMMA  &kp RET 
            >;
        };

        lower_layer {
            // ---------------------https://github.com/FlaviaRas/zmk-configold/issues--------------------------------------------------------------------
            // | N/A | LWR | ⌫ | -(~)| @(&)| !(#)|      |  1  |  2  |  3  | =(+)| RSE | N/A |
            // | N/A | /(\)| <(>)| £($)| :(;)| ?(^)|      |  4  |  5  |  6  | %(*)|esttb| N/A |
            // | N/A |coppy| _(|)| {(})| [(])| (())|      |  7  |  8  |  9  |     |     | N/A |
            //                    | CTRL | .(') | __ |  |  ⬆  | 0(,) |  ↵  |

            bindings = <
&trans       &trans          &trans          &mt PIPE MINUS   &mt AMPS DQT   &mt BSLH EXCL             &one       &two       &three      &equlpls        &trans         &trans
&trans  &mt NON_US_BACKSLASH FSLH &mt GT LT  &mt DOLLAR POUND &mt SEMI COLON &mt CARET QMARK           &four      &five      &six        &prcntastk      &esctb         &trans
&trans       &trans          &mt PIPE2 UNDER &mt RBRC LBRC    &mt RBKT LBKT  &mt RPAR LPAR             &seven     &eight     &nine       &trans          &trans         &trans
                                                  &trans         &trans          &trans              &trans       &zero      &trans
            >;   
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // | N/A | LWR | ⌫ |  ⬆  |     |     |      |  V+ |  V- |  Vx |PSCN | RSE | N/A |
            // | N/A |     |  ⬅ |  ⬇  |  ⮕ |     |      | sc⬇ | sc⬆ |     |  B+ |  B- | N/A |
            // | N/A |     |     |     |     |     |      |     |     |     |     | WIN | N/A |
            //                    | CTRL | .(') | __ |  |  ⬆  | ,(") |  ↵  |

            bindings = <
&trans         &trans          &trans         &kp UP          &trans         &trans                    &vols          &bri            &msc SCRL_UP     &kp PSCRN        &trans           &trans
&trans         &trans          &kp LEFT       &kp DOWN        &kp RIGHT      &trans                    &trans         &msc SCRL_LEFT  &msc SCRL_DOWN   &msc SCRL_RIGHT  &kp RWIN         &trans
&trans         &trans          &trans         &trans          &trans         &trans                    &btmorph       &trans          &trans           &trans           &trans           &trans
                                                  &trans         &trans          &trans          &trans         &trans          &trans 
            >;   
        };
    };
};
